# Plantilla de variables de entorno (datos dummy).
# Spring Boot NO carga este archivo automáticamente. Copia a .env y expórtalo antes de arrancar:
#   set -a; . ./.env; set +a
#
# Configuración de base de datos
DB_URL=jdbc:mysql://localhost:3306/hard_track_db
DB_USERNAME=usuario_demo
DB_PASSWORD=password_demo

# Configuración del servidor
SERVER_PORT=8097

# Configuración de la aplicación
SPRING_APPLICATION_NAME=hardtrack
